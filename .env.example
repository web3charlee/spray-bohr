# `npm run deploy:bohr` (or deploy:botmainnet) writes these for you. Copy this file to .env only if you want to fill them in by hand.
# These are public addresses. NEVER put a private key in this file or any file you commit.
VITE_NETWORK=bohr               # bohr (testnet, default) or botmainnet (real money)
VITE_SPRAY_ADDRESS=0x...        # Spray contract
VITE_TOKEN_ADDRESS=0x...        # TestUSDC contract (testnet only; mainnet uses BOT's USDT automatically)
VITE_SPRAY_DEPLOY_BLOCK=0       # block number of the Spray deploy tx
